.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# G1-A native I/O probe (Issue #11): local build tooling and installed
# dependencies are never committed. The pinned compiler download and its
# digest are documented in tests/fixtures/zmachine/README.md.
tests/fixtures/zmachine/tools/
experiments/**/node_modules/
experiments/**/dist/

# Mimosa hook state is local tooling state, never committed (any depth)
.mimosa/
experiments/vm-io/tools/
experiments/vm-io/results/tmp-negative/
/recovery

# G1-B checkpoint probe scratch (results/ is regenerated test scratch, never evidence)
experiments/vm-checkpoint/results/
